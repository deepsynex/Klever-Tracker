# Copy to .env.local and adjust. Never commit .env.local.

# Klever Tracker GraphQL endpoint (server-side only; never exposed to the browser).
KLEVER_GRAPHQL_URL=https://tiretracker.klever.ae/graphql

# Development only: answer auth operations from a built-in mock instead of the real API.
# Ignored when NODE_ENV=production. Demo login: admin@demo.test / Demo@12345
KLEVER_MOCK=false

# Username and password for the HTTP basic-auth lock in front of the API, if there is one
# (api-alignment.md B1). Only sent on requests without a login token: login, password reset, ping.
KLEVER_BASIC_AUTH_USER=
KLEVER_BASIC_AUTH_PASSWORD=

# Origins allowed to call /api/graphql (comma-separated). Empty = same host as the request.
APP_ALLOWED_ORIGINS=

# Display name in the UI.
NEXT_PUBLIC_APP_NAME=Klever Tracker

# Google Maps API Key for vehicle tracking history and map views
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to true only after enabling the Routes API for the key above in Google Cloud Console
# (and allowing it in the key's API restrictions). It powers "Exact Road Path" on the history
# map; without it the map draws the raw GPS track.
NEXT_PUBLIC_GOOGLE_ROUTES_ENABLED=false

# Google sign-in: a Klever account allowed to list users, used only to check that a
# Google email belongs to a registered user. Leave empty to show "try again later".
KLEVER_SERVICE_EMAIL=
KLEVER_SERVICE_PASSWORD=

# Live notifications over Laravel Reverb (backend-requests/geofencing-realtime.md, G4).
# Leave the key or host empty and the notification bell polls every 30 seconds instead.
# All public: the key identifies the Reverb app, it isn't a secret (API Doc §6.22).
NEXT_PUBLIC_REVERB_APP_KEY=85a8f21e99d15b52dd2e
# Public WebSocket host, without a scheme, e.g. ws.tiretracker.klever.ae (not live yet: needs the wss:// reverse proxy)
NEXT_PUBLIC_REVERB_HOST=
# 443 for wss (default), or the port Reverb listens on
NEXT_PUBLIC_REVERB_PORT=443
# https (wss, default) or http (ws, local Reverb only)
NEXT_PUBLIC_REVERB_SCHEME=https
# Private channel prefix the backend broadcasts on; the user id is appended (default user.)
NEXT_PUBLIC_REVERB_USER_CHANNEL_PREFIX=user.

# Browser push through Firebase Cloud Messaging (backend G5, API Doc §6.22), project tiretraker-72b58.
# Firebase console → Project settings → General → Your apps (web app config), and
# Cloud Messaging → Web Push certificates (the key pair's public key). All public values.
# While any is empty, the push switch says browser notifications aren't set up yet.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD3vqcSeFzCsud4BrLuyfUD4Dcm0cKLRVU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tiretraker-72b58.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tiretraker-72b58
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=852594158035
NEXT_PUBLIC_FIREBASE_APP_ID=1:852594158035:web:3b14b971d9d9c695712726
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BEj3evqyfTlBi969sG9A68uPPiV6Lx5aiTTSkjRlY9nV4R5qCBVWZgY4l8etHrhd9fbg0HwMr3psBe_PhCBCZ3M
