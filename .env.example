# Copy to .env.local and adjust. Never commit .env.local.

# Klever Tracker GraphQL endpoint (server-side only; never exposed to the browser).
KLEVER_GRAPHQL_URL=https://tiretracker.klever.ae/graphql

# Development only: answer auth operations from a built-in mock instead of the real API.
# Ignored when NODE_ENV=production. Demo login: admin@demo.test / Demo@12345
KLEVER_MOCK=false

# Username and password for the HTTP basic-auth lock in front of the API, if there is one
# (api-alignment.md B1). Only sent on requests without a login token: login, password reset, ping.
KLEVER_BASIC_AUTH_USER=
KLEVER_BASIC_AUTH_PASSWORD=

# Origins allowed to call /api/graphql (comma-separated). Empty = same host as the request.
APP_ALLOWED_ORIGINS=

# Display name in the UI.
NEXT_PUBLIC_APP_NAME=Klever Tracker

# Google Maps API Key for vehicle tracking history and map views
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to true only after enabling the Routes API for the key above in Google Cloud Console
# (and allowing it in the key's API restrictions). It powers "Exact Road Path" on the history
# map; without it the map draws the raw GPS track.
NEXT_PUBLIC_GOOGLE_ROUTES_ENABLED=false
